        <mxCell id="p1_dnn_eval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#805AD5;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_dnn" target="p1_eval">
