        <mxCell id="p1_xgb_eval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#DD6B20;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_xgb" target="p1_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_note" value="&lt;b&gt;Nota metodológica:&lt;/b&gt; comparabilidad no significa preprocesamiento idéntico. Las transformaciones necesarias para cada algoritmo permanecen dentro de su pipeline; lo que debe ser idéntico es la evidencia experimental que entra y la evaluación que sale." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;dashed=1;dashPattern=4 3;fillColor=#FFFCF0;strokeColor=#B7791F;fontColor=#5F370E;fontFamily=Inter,Helvetica,Arial;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
