        <mxCell id="p1_title" value="Comparación controlada de algoritmos de clasificación" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Inter,Helvetica,Arial;fontSize=28;fontStyle=1;fontColor=#102A43;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_subtitle" value="Actividad 4 · Mismos datos, particiones espaciales y criterios de evaluación; diferente mecanismo de aprendizaje" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Inter,Helvetica,Arial;fontSize=15;fontColor=#486581;" vertex="1" parent="1">
          <mxGeometry x="100" y="62" width="1400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p1_common" value="&lt;b&gt;PROTOCOLO EXPERIMENTAL COMÚN&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2;fillColor=#F0F7FF;strokeColor=#2B6CB0;fontColor=#102A43;fontFamily=Inter,Helvetica,Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="1500" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p1_data" value="&lt;b&gt;Matriz de modelado congelada&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mismos puntos, variable objetivo,&lt;br/&gt;clases y columnas predictoras&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#4C78A8;fontColor=#1A365D;fontFamily=Inter,Helvetica,Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="160" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1_split" value="&lt;b&gt;Partición espacial única&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Un holdout independiente + cinco folds;&lt;br/&gt;cuadrantes completos, sin fuga espacial&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#4C78A8;fontColor=#1A365D;fontFamily=Inter,Helvetica,Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1_rules" value="&lt;b&gt;Reglas comunes de selección&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Misma métrica objetivo, semillas,&lt;br/&gt;etapas y conjunto de métricas finales&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#4C78A8;fontColor=#1A365D;fontFamily=Inter,Helvetica,Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1085" y="160" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1_hub" value="&lt;b&gt;Cuatro pipelines bajo la misma especificación experimental&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;strokeWidth=2;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFFFFF;fontFamily=Inter,Helvetica,Arial;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="275" width="660" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1_edge_common" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2B6CB0;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_common" target="p1_hub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_rf" value="&lt;b&gt;RANDOM FOREST&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mediana → bootstrap + subconjuntos&lt;br/&gt;aleatorios → árboles en paralelo →&lt;br/&gt;promedio de probabilidades&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2.5;fillColor=#EAF7EE;strokeColor=#2F855A;fontColor=#184C2A;fontFamily=Inter,Helvetica,Arial;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="365" width="335" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p1_dnn" value="&lt;b&gt;DNN TABULAR&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mediana + estandarización →&lt;br/&gt;6 capas densas × 200 (tanh + dropout)&lt;br/&gt;→ logits → clase&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2.5;fillColor=#F3EEFF;strokeColor=#805AD5;fontColor=#44337A;fontFamily=Inter,Helvetica,Arial;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="435" y="365" width="335" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p1_svm" value="&lt;b&gt;SVM ESCALABLE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mediana + estandarización → rama lineal&lt;br/&gt;o Nyström (RBF) → LinearSVC OVR&lt;br/&gt;→ máxima función de decisión&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2.5;fillColor=#EAF4FF;strokeColor=#3182CE;fontColor=#1A365D;fontFamily=Inter,Helvetica,Arial;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="365" width="335" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p1_xgb" value="&lt;b&gt;XGBOOST&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Árbol inicial → gradientes del error →&lt;br/&gt;árboles secuenciales regularizados →&lt;br/&gt;suma de scores → softprob&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2.5;fillColor=#FFF5E6;strokeColor=#DD6B20;fontColor=#7B341E;fontFamily=Inter,Helvetica,Arial;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1215" y="365" width="335" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_rf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.8;strokeColor=#2F855A;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_hub" target="p1_rf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_dnn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.8;strokeColor=#805AD5;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_hub" target="p1_dnn">
          <mxGeometry relative="1" as="geometry" />
