          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_eval" value="&lt;b&gt;EVALUACIÓN COMÚN Y SELECCIÓN DEL ENFOQUE ÓPTIMO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2;fillColor=#F7FAFC;strokeColor=#486581;fontColor=#102A43;fontFamily=Inter,Helvetica,Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
