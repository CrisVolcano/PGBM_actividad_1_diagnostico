        </mxCell>
        <mxCell id="p1_metrics" value="&lt;b&gt;Desempeño&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;OA · Kappa · F1&lt;br/&gt;PA/recall · PU/precision&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#829AB1;fontColor=#243B53;fontFamily=Inter,Helvetica,Arial;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="95" y="675" width="315" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1_errors" value="&lt;b&gt;Errores y estabilidad&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Matriz de confusión · errores dominantes&lt;br/&gt;variación entre folds · intervalos de confianza&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#829AB1;fontColor=#243B53;fontFamily=Inter,Helvetica,Arial;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="455" y="675" width="370" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1_ops" value="&lt;b&gt;Factibilidad operativa&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Tiempo · memoria · costo computacional&lt;br/&gt;interpretabilidad · complejidad de despliegue&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#829AB1;fontColor=#243B53;fontFamily=Inter,Helvetica,Arial;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="870" y="675" width="370" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1_choice" value="&lt;b&gt;RECOMENDACIÓN FINAL&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ranking válido solo si coinciden&lt;br/&gt;datos, folds y holdout&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2;fillColor=#E6FFFA;strokeColor=#2C7A7B;fontColor=#234E52;fontFamily=Inter,Helvetica,Arial;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
